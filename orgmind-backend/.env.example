# OrgMind 系统环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# 项目名称
PROJECT_NAME=OrgMind System
API_V1_STR=/api/v1

# 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orgmind

# 安全配置
SECRET_KEY=your_very_secret_key_here_min_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# RAG / AI 模型配置
# 支持多种模型提供商：Baizhi Cloud、OpenAI、阿里云等
DEFAULT_BASE_URL=https://your-model-provider.com/v1

# 对话模型配置
CHAT_API_KEY=your_chat_api_key_here
CHAT_BASE_URL=https://your-model-provider.com/v1
CHAT_MODEL=deepseek-v3

# 文本向量化模型配置
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://your-model-provider.com/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# 重排序模型配置
RERANK_API_KEY=your_rerank_api_key_here
RERANK_BASE_URL=https://your-model-provider.com/v1
RERANK_MODEL=bge-reranker-v2-m3

# 可选配置项
# 如果以下配置为空，系统将使用对应的默认配置
# CHAT_API_KEY=
# EMBEDDING_API_KEY=
# RERANK_API_KEY=